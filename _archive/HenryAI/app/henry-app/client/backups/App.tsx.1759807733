import { useState } from "react";

type Msg = { role: "you" | "henry"; text: string };

export default function App(){
  const [msgs,setMsgs] = useState<Msg[]>([
    { role: "henry", text: "Hi Topher — Henry here. What do you want to do?" }
  ]);
  const [q,setQ] = useState("");
  const [citeOnly,setCiteOnly] = useState(false);

  async function send(){
    const textRaw=q.trim(); if(!textRaw) return; const text = "Be concise, friendly, helpful. Do not cite sources unless I ask. " + textRaw;
    setMsgs(m=>[...m,{role:"you",text}]); setQ("");
    try{
      const r = await fetch("/ask",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({query:text, localOnly:citeOnly})});
      const j:any = await r.json();
      const a = j?.answer ?? j?.text ?? j?.error ?? "(no answer)";
      setMsgs(m=>{const last=m[m.length-1]?.text||""; return a&&a!==last?[...m,{role:"henry",text:a}]:m;});
    }catch(e:any){ setMsgs(m=>[...m,{role:"henry",text:"Error: "+(e?.message||String(e))}]); }
  }

  return (
    <div className="app">
      <aside className="sidebar">Henry AI</aside>
      <main className="chat">
        <div className="messages">
          {msgs.map((m,i)=>(<div key={i} className={"bubble "+(m.role==="you"?"me":"")}>{m.text}</div>))}
        </div>
        <div className="toolbar"><label><input type="checkbox" checked={citeOnly} onChange={e=>setCiteOnly(e.target.checked)} /> Cite only my files</label></div>
        <div className="inputRow">
          <textarea value={q} onChange={e=>setQ(e.target.value)}
            onKeyDown={e=>{ if(e.key==="Enter" && !e.shiftKey){ e.preventDefault(); send(); } }}
            placeholder="Type and press Enter… (Shift+Enter for newline)" />
          <button onClick={send}>Send</button>
        </div>
      </main>
    </div>
  );
}
