<!doctype html><meta charset="utf-8"><meta name=viewport content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Henry AI</title>
<style>
  :root{--bg:#fff;--fg:#111;--line:#e5e5e5;--muted:#666;--chip:#f5f5f5}
  *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  header{position:sticky;top:0;z-index:3;background:#fff;border-bottom:1px solid var(--line);padding:12px 14px;display:flex;justify-content:space-between;align-items:flex-end}
  h1{margin:0;font-size:18px} .sub{color:var(--muted);font-size:12px;margin-top:2px}
  .pill{background:#fafafa;border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:12px}
  .wrap{display:grid;grid-template-columns:260px 1fr 320px;gap:12px;padding:12px}
  .panel{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .left,.right{height:calc(100vh - 86px);position:sticky;top:74px;overflow:auto}
  .left h3,.right h3{margin:10px 10px 6px;font-size:12px;color:#333;text-transform:uppercase;letter-spacing:.04em}
  .list{padding:6px}
  .item{padding:8px;border:1px solid var(--line);border-radius:8px;margin:6px;cursor:pointer}
  .item.active{background:#fafafa}
  .chat{display:flex;flex-direction:column;height:calc(100vh - 86px)}
  .settings{border-bottom:1px solid var(--line)}
  .settings summary{cursor:pointer;padding:10px 12px;font-weight:600}
  .settings .body{padding:0 12px 12px}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  input,select,textarea,button{font:inherit}
  input,select{border:1px solid var(--line);border-radius:8px;padding:8px;background:#fff}
  .controls{display:flex;gap:12px;flex-wrap:wrap;align-items:center;padding:10px;border-bottom:1px solid var(--line)}
  .controls label{display:flex;gap:6px;align-items:center;font-size:13px;color:#333}
  .controls input[type=range]{width:140px}
  .messages{flex:1;overflow:auto;padding:12px}
  .bubble{border:1px solid var(--line);border-radius:12px;padding:10px;margin:8px 0;white-space:pre-wrap}
  .user{background:#eef6ff;border-color:#d7e9ff}
  .assistant{background:#fcfcfc}
  .composer{display:flex;gap:8px;padding:10px;border-top:1px solid var(--line)}
  textarea#q{flex:1;height:120px;border:1px solid var(--line);border-radius:10px;padding:10px}
  button{border:1px solid var(--line);border-radius:10px;padding:8px 14px;background:#fafafa;cursor:pointer}
  .chip{display:inline-block;background:var(--chip);border:1px solid var(--line);border-radius:999px;padding:4px 8px;margin:4px 6px 0 0;font-size:12px}
  .src{white-space:pre-wrap;font-size:12px;border-top:1px solid var(--line);padding:8px 10px}
  .muted{color:var(--muted);font-size:12px}

  @media (prefers-color-scheme: dark){
  :root{
    --bg:#0d1117;        /* page */
    --fg:#e6edf3;        /* text */
    --line:#30363d;      /* borders */
    --muted:#9aa4b2;
    --chip:#151b23;      /* chips/pills */
  }
  body, header, .panel, .controls, .settings, .composer { background:#0d1117 !important; color:var(--fg); }
  .panel { background:#0f141b !important; border-color:#30363d !important; }
  .item, textarea#q, input, select, button, .bubble { background:#0f141b !important; border-color:#30363d !important; color:var(--fg); }
  .bubble.assistant { background:#0f1722 !important; }
  .bubble.user      { background:#0a2340 !important; border-color:#1b3c64 !important; }
  .list .item.active{ background:#0f1722 !important; }
  .pill, .chip      { background:#151b23 !important; border-color:#30363d !important; color:var(--fg); }
  .src, .muted      { color:#9aa4b2 !important; }
  a, a:visited      { color:#58a6ff; }
  /* Inputs: placeholder + selection */
  ::placeholder     { color:#7d8a98; }
  ::selection       { background:#1f6feb; color:#fff; }
  /* Keyboard focus ring */
  :focus-visible    { outline:2px solid #1f6feb; outline-offset:2px; }
}
[data-theme="dark"]{
  --bg:#0d1117; --fg:#e6edf3; --line:#30363d; --muted:#9aa4b2; --chip:#151b23;
}

  /* --- Henry Dark (standalone) --- */
  </style><style id="henry-dark">
  [data-theme="dark"]{
    --bg:#0d1117; --fg:#e6edf3; --line:#30363d; --muted:#9aa4b2; --chip:#151b23;
  }
  [data-theme="dark"] body{ background:#0d1117; color:var(--fg); }
  [data-theme="dark"] header,
  [data-theme="dark"] .panel,
  [data-theme="dark"] .controls,
  [data-theme="dark"] .settings,
  [data-theme="dark"] .composer{ background:#0d1117; color:var(--fg); }
  [data-theme="dark"] .panel{ background:#0f141b !important; border-color:#30363d !important; }
  [data-theme="dark"] .item,
  [data-theme="dark"] textarea#q,
  [data-theme="dark"] input,
  [data-theme="dark"] select,
  [data-theme="dark"] button,
  [data-theme="dark"] .bubble{ background:#0f141b !important; border-color:#30363d !important; color:var(--fg); }
  [data-theme="dark"] .bubble.assistant{ background:#0f1722 !important; }
  [data-theme="dark"] .bubble.user{ background:#0a2340 !important; border-color:#1b3c64 !important; }
  [data-theme="dark"] .list .item.active{ background:#0f1722 !important; }
  [data-theme="dark"] .pill, [data-theme="dark"] .chip{ background:#151b23 !important; border-color:#30363d !important; color:var(--fg); }
  [data-theme="dark"] .src, [data-theme="dark"] .muted{ color:#9aa4b2 !important; }
  [data-theme="dark"] a, [data-theme="dark"] a:visited{ color:#58a6ff; }
  [data-theme="dark"] ::placeholder{ color:#7d8a98; }
  [data-theme="dark"] ::selection{ background:#1f6feb; color:#fff; }
  [data-theme="dark"] :focus-visible{ outline:2px solid #1f6feb; outline-offset:2px; }
  </style>
  <style>


<header>
  <div><h1>Henry AI</h1><div class=sub>your go to guy</div></div>
  <div class="row" style="gap:8px;align-items:center">
       <button id="themeToggle" class="pill" title="Toggle theme">🌓</button>
       <span id=status class=pill>checking…</span>
     </div>
</header>

<div class="wrap">
  <!-- History -->
  <aside class="panel left">
    <h3>History</h3>
    <div id=history class=list></div>
  </aside>

  <!-- Chat -->
  <main class="panel chat">
    <details class="settings" open id=cred>
      <summary>Settings</summary>
      <div class="body">
        <div class="row" style="margin-top:8px">
          <label>Provider
            <select id=provider>
              <option value="openai">OpenAI (cloud)</option>
              <option value="ollama">Ollama (local)</option>
            </select>
          </label>
          <label>OpenAI model <input id=oa_model value="gpt-4o-mini"></label>
          <label>Ollama model <input id=ol_model value="qwen2.5:3b-instruct"></label>
        </div>
        <div class="row" style="margin-top:8px">
          <input id=oa_key type=password placeholder="API key (sk-… or sk-proj-…)" style="min-width:280px">
          <input id=oa_proj placeholder="Project ID (proj_… if using sk-proj-…)" style="min-width:240px">
          <button id=save>Save & Apply</button>
          <button id=applyKC>Apply from Keychain</button>
        </div>
        <div class=muted>Keys live in memory; “Apply from Keychain” uses HENRY_OPENAI_KEY / HENRY_OPENAI_PROJECT.</div>
      </div>
    </details>

    <div class="controls">
      <label>Mode
        <select id=mode>
          <option value="chat">Chat</option>
          <option value="writer">Writer</option>
          <option value="coder">Coder</option>
          <option value="organizer">Organizer</option>
        </select>
      </label>
      <label>Temperature <input id=temp type=range min=0 max=2 step=0.1 value=0.3><span id=tempv class=chip>0.3</span></label>
      <label><input id=cite type=checkbox checked> Cite only from my files</label>
    </div>

    <div id=messages class=messages></div>

    <div class="composer">
      <textarea id=q placeholder="Type…  (Enter = send, Shift+Enter = newline, Cmd/Ctrl+Enter = send)"></textarea>
      <button id=ask>Ask</button>
    </div>
  </main>

  <!-- Sources -->
  <aside class="panel right">
    <h3>Sources</h3>
    <div id=sources style="padding:10px 10px 2px"></div>
    <div class="src muted" style="border:none">Tip: “debug retrieval” shows top chunks with scores.</div>
    <div style="padding:8px 10px"><a id=dbg href="/debug/snippets?q=Genesis%201" target=_blank class=muted>debug retrieval</a></div>
  </aside>
</div>

<script>
(function(){
  // --- minor state ---
  var hist = [];
  function renderHistory(){
    var H = document.getElementById('history'); H.innerHTML = '';
    hist.forEach(function(m,i){
      var d=document.createElement('div'); d.className='item'+(i===hist.length-1?' active':'');
      d.textContent = (m.role==='user'?'You: ':'Henry: ') + m.text.slice(0,60);
      H.appendChild(d);
    });
  }
  function push(role, text){
    var box=document.getElementById('messages');
    var b=document.createElement('div'); b.className='bubble '+(role==='user'?'user':'assistant'); b.textContent=text;
    box.appendChild(b); box.scrollTop=box.scrollHeight;
    hist.push({role,text}); renderHistory();
  }
  function setPill(h){ var p=document.getElementById('status'); p.textContent = h.provider+' • model: '+h.model+' • chunks: '+h.chunks+' • key:'+(h.hasOpenAIKey?'yes':'no'); }
  function refresh(){ return fetch('/health').then(r=>r.json()).then(setPill).catch(()=>{document.getElementById('status').textContent='health error';}); }

  // --- settings ---
  var temp=document.getElementById('temp'), tempv=document.getElementById('tempv'); temp.oninput=function(){ tempv.textContent=temp.value; };
  document.getElementById('save').onclick = function(){
    var btn=this; btn.disabled=true; var old=btn.textContent; btn.textContent='Saving…';
    var body = {
      provider: document.getElementById('provider').value,
      openaiKey: document.getElementById('oa_key').value || undefined,
      openaiProject: document.getElementById('oa_proj').value || undefined,
      chatModelOpenAI: document.getElementById('oa_model').value,
      chatModelOllama: document.getElementById('ol_model').value
    };
    fetch('/config',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)})
      .then(r=>r.json())
      .then(function(){ document.getElementById('oa_key').value=''; return refresh(); })
      .then(function(){ var d=document.getElementById('cred'); if(d && d.open) d.open=false; var q=document.getElementById('q'); q.focus(); q.scrollIntoView({behavior:'smooth',block:'end'}); })
      .catch(e=>alert('Save failed: '+e))
      .finally(function(){ btn.disabled=false; btn.textContent=old; });
  };
  document.getElementById('applyKC').onclick=function(){
    fetch('/keychain/apply',{method:'POST'}).then(r=>r.json()).then(r=>{ alert(r.ok?'Applied from Keychain':'Keychain error'); refresh(); }).catch(e=>alert('Keychain error: '+e));
  };

  // --- sending ---
  function collectOpts(){
    return {
      mode: document.getElementById('mode').value,
      citeOnly: document.getElementById('cite').checked,
      temperature: Number(document.getElementById('temp').value)
    };
  }
  function send(){
    var qEl=document.getElementById('q'); var text=(qEl.value||'').trim(); if(!text){ qEl.focus(); return; }
    push('user', text); qEl.value=''; qEl.focus();
    document.getElementById('sources').innerHTML='';
    fetch('/ask',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:text, options: collectOpts()})})
      .then(r=>r.json())
      .then(function(res){
        push('assistant', res.answer || JSON.stringify(res,null,2));
        (res.sources||[]).forEach(function(s){
          var el=document.createElement('div'); el.className='src';
          var sc=typeof s.score==='number'? s.score.toFixed(3) : (s.score||'');
          el.textContent='['+s.doc+'] ('+sc+') '+s.ref;
          document.getElementById('sources').appendChild(el);
        });
      })
      .catch(function(e){ push('assistant','error: '+e); });
  }
  document.getElementById('ask').onclick=send;
  var qBox=document.getElementById('q');
  qBox.addEventListener('keydown',function(e){
    if(e.key==='Enter' && (e.metaKey||e.ctrlKey)){ e.preventDefault(); send(); return; }
    if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); send(); }
  });

  // Cmd/Ctrl+S = Save
  document.addEventListener('keydown',function(e){ var k=e.key||''; if((e.metaKey||e.ctrlKey)&&(k==='s'||k==='S')){ e.preventDefault(); var b=document.getElementById('save'); if(b && !b.disabled) b.click(); } });

  refresh();
})();

function applyTheme(t){ if(t==='dark'){document.documentElement.setAttribute('data-theme','dark');} else {document.documentElement.removeAttribute('data-theme');} }
(function(){
  var key='henry.theme', cur=localStorage.getItem(key) || (window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
  applyTheme(cur);
  var btn=document.getElementById('themeToggle');
  if(btn){ btn.addEventListener('click', ()=>{ cur = (cur==='dark'?'light':'dark'); localStorage.setItem(key,cur); applyTheme(cur); }); }
})();
</script>