 "./tweaks.css";
:root{
  --bg:#0f1115; --panel:#151922; --panel2:#0f141c; --text:#dde3ee; --muted:#9aa8bf; --accent:#4da3ff; --chip:#1f2633; --ok:#2ecc71;
}
*{box-sizing:border-box}
html,body,#root{height:100%;margin:0;background:var(--bg);color:var(--text);font:14px/1.4 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Inter,Arial}
.app{display:grid;grid-template-columns:260px 1fr;grid-template-rows:auto 1fr auto;height:100%}
.sidebar{grid-row:1/4;padding:14px;background:var(--panel2);border-right:1px solid #1a2230}
.brand{font-weight:700;margin-bottom:12px}
.pill{display:inline-flex;gap:6px;align-items:center;font-size:12px;background:var(--chip);border:1px solid #1e2a3a;border-radius:999px;padding:4px 9px;margin-top:6px}
.pill .dot{width:8px;height:8px;border-radius:999px;background:var(--ok)}
.header{grid-column:2;padding:10px 14px;background:var(--panel);border-bottom:1px solid #1a2230;display:flex;align-items:center;gap:8px}
.badge{background:#172033;border:1px solid #203049;border-radius:8px;padding:6px 10px;font-size:12px;color:var(--muted)}
.main{grid-column:2;overflow:auto;padding:16px}
.message{background:#111827;border:1px solid #1f2937;border-radius:14px;padding:12px 14px;max-width:920px;margin:10px 0;white-space:pre-wrap}
.message.user{background:#0f1725;border-color:#223148}
.message.sys{opacity:.9}
.quick{display:flex;flex-direction:column;gap:8px;margin:6px 0 14px;max-width:920px}
.quick button{all:unset;background:#0f1725;border:1px solid #223148;border-radius:10px;padding:10px 12px;cursor:pointer}
.controls{display:flex;gap:16px;align-items:center;color:var(--muted);max-width:920px;margin:6px 0}
.controls label{display:flex;gap:8px;align-items:center;cursor:pointer}
.composerWrap{grid-column:2;background:linear-gradient(180deg,transparent,rgba(0,0,0,.25));border-top:1px solid #1a2230;padding:10px 14px;position:sticky;bottom:0}
.composer{display:flex;gap:10px;max-width:920px;margin:0 auto}
textarea.input{flex:1;min-height:56px;max-height:160px;resize:vertical;background:#0f1725;border:1px solid #223148;border-radius:10px;color:var(--text);padding:10px 12px}
button.send{all:unset;background:var(--accent);color:#002246;border-radius:10px;padding:0 14px;display:flex;align-items:center;justify-content:center;min-width:64px;cursor:pointer;font-weight:700}
.sources{display:none;max-width:920px;margin:6px 0;color:var(--muted);font-size:12px}
.sources.show{display:block}
@import