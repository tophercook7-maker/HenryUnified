export type SpeakOpts={ text:string; voiceHint?:string; rate?:number; pitch?:number; volume?:number };
let cachedVoice: SpeechSynthesisVoice|null;
function pickVoice(hint?:string){
  const v=window.speechSynthesis.getVoices(); if(!v.length) return undefined;
  const hintLC=(hint||"").toLowerCase(); const prefer=["male","daniel","alex","english","en-us","en-gb"];
  const order=[hintLC,...prefer];
  for(const key of order){ if(!key) continue; const hit=v.find(x=>(x.name||"").toLowerCase().includes(key)||(x.lang||"").toLowerCase().includes(key)); if(hit) return hit; }
  return v.find(x=>x.lang?.toLowerCase().startsWith("en"))||v[0];
}
export function speak({text,voiceHint="male",rate=1,pitch=1,volume=1}:SpeakOpts){
  if(!("speechSynthesis" in window)) return; window.speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text); if(!cachedVoice){ cachedVoice=pickVoice(voiceHint); }
  u.voice=cachedVoice||pickVoice(voiceHint)||null; u.rate=rate; u.pitch=pitch; u.volume=volume; window.speechSynthesis.speak(u);
}
