export type SpeakOpts={ text:string; voiceHint?:string; rate?:number; pitch?:number; volume?:number };
let cachedVoice: SpeechSynthesisVoice | null = null;
function pickVoice(hint?:string): SpeechSynthesisVoice | null {
  const vs = (typeof window!=="undefined" && (window as any).speechSynthesis?.getVoices?.()) || [];
  if(!vs.length) return null;
  const hintLC=(hint||"").toLowerCase(); const prefer=["male","daniel","alex","english","en-us","en-gb"];
  for(const key of [hintLC, ...prefer]){
    if(!key) continue;
    const hit=vs.find(v=>(v.name||"").toLowerCase().includes(key) || (v.lang||"").toLowerCase().includes(key));
    if(hit) return hit;
  }
  return vs.find(v=>(v.lang||"").toLowerCase().startsWith("en")) || vs[0] || null;
}
export function speak({text,voiceHint="male",rate=1,pitch=1,volume=1}:SpeakOpts){
  if(typeof window==="undefined" || !(window as any).speechSynthesis) return;
  (window as any).speechSynthesis.cancel();
  const u = new (window as any).SpeechSynthesisUtterance(text);
  if(!cachedVoice) cachedVoice = pickVoice(voiceHint);
  u.voice = cachedVoice || pickVoice(voiceHint) || null;
  u.rate = rate; u.pitch = pitch; u.volume = volume;
  (window as any).speechSynthesis.speak(u);
}
