import "dotenv/config";
import express from "express";
import bodyParser from "body-parser";
import fs from "fs";
import path from "path";
import { OpenAI } from "openai";

type Chunk = {
  id: string;
  doc: string;
  ref: string;
  content: string;
  embedding: number[];
};

const app = express();
app.use(bodyParser.json({ limit: "2mb" }));

const dataFile = path.resolve(__dirname, "../data/chunks.json");
let CHUNKS: Chunk[] = [];
function loadIndex() {
  CHUNKS = fs.existsSync(dataFile) ? JSON.parse(fs.readFileSync(dataFile, "utf8")) : [];
}
loadIndex();

const openai = new OpenAI({ apiKey: getKey() });

function cosine(a: number[], b: number[]) {
  let dot=0, na=0, nb=0;
  const len = Math.min(a.length, b.length);
  for (let i=0;i<len;i++){ const ai=a[i], bi=b[i]; dot+=ai*bi; na+=ai*ai; nb+=bi*bi; }
  return dot/(Math.sqrt(na)*Math.sqrt(nb) || 1);
}

app.get("/health", (_req, res) => {
  res.json({
    ok: true,
    model: "gpt-4o-mini",
    hasKey: !!process.env.OPENAI_API_KEY,
    billing: false,
    chunks: CHUNKS.length
  });
});

app.post("/reload", (_req, res) => { loadIndex(); res.json({ ok: true, chunks: CHUNKS.length }); });

app.post("/ask", async (req, res) => {
  try {
    const q = String(req.body?.query ?? "").slice(0, 4000);
    if (!q) return res.status(400).json({ error: "missing query" });
    if (!CHUNKS.length) return res.status(400).json({ error: "no knowledge indexed yet" });

    const emb = await openai.embeddings.create({ model: "text-embedding-3-large", input: q });
    const qvec = emb.data[0].embedding as number[];

    const scored = CHUNKS
      .map(c => ({ c, score: cosine(qvec, c.embedding) }))
      .sort((a,b)=>b.score - a.score)
      .slice(0, 8);

    const context = scored.map(s => `[${s.c.doc}] ${s.c.content}`).join("\n\n");
    const system = "You are Henry Companion. Answer using ONLY the provided context. If context is insufficient, say so. Cite sources like [KJV] or [1_Enoch].";

    const chat = await openai.chat.completions.create({
      model: "gpt-4o-mini",
      messages: [
        { role: "system", content: system },
        { role: "user", content: `${q}\n\nContext:\n${context}` }
      ]
    });

    res.json({
      answer: chat.choices[0].message.content,
      sources: scored.map(s => ({ doc: s.c.doc, ref: s.c.ref, score: s.score }))
    });
  } catch (e:any) {
    res.status(500).json({ error: e?.message || String(e) });
  }
});

app.listen(3000, () => console.log("Henry listening on http://127.0.0.1:3000"));
