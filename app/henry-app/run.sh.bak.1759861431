#!/usr/bin/env bash
set -euo pipefail

app_dir="$(cd "$(dirname "$0")" && pwd)"
pidfile="$app_dir/server.pid"
logfile="$app_dir/server.log"

color(){ tput setaf "$1" 2>/dev/null || true; }
norm(){ tput sgr0 2>/dev/null || true; }

start(){
  color 6; echo "[run] Clean up…"; norm
  lsof -ti :3000 | xargs -r kill -9 || true
  pkill -f "ts-node src/server.ts" 2>/dev/null || true
  pkill -f "watch.sh" 2>/dev/null || true
  rm -f "$pidfile" .rebuild.lock

  color 6; echo "[run] Build client…"; norm
  cd "$app_dir/client" && pnpm build && cd "$app_dir"
  rsync -a --delete client/dist/ public/

  color 6; echo "[run] Start server…"; norm
  nohup npx ts-node --transpile-only src/server.ts > "$logfile" 2>&1 & echo $! > "$pidfile"
  sleep 0.5
  if ! kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
    color 1; echo "[run] ❌ server didn't start. Last logs:"; norm; tail -n 80 "$logfile" || true; exit 1; fi

  color 6; echo "[run] Start watcher (frontend)…"; norm
  nohup "$app_dir/watch.sh" > "$app_dir/watch.log" 2>&1 & echo $! > "$app_dir/watch.pid"
  color 2; echo "[run] ✅ Henry at http://127.0.0.1:3000"; norm
}

stop(){
  color 6; echo "[run] Stop everything…"; norm
  lsof -ti :3000 | xargs -r kill -9 || true
  pkill -f "ts-node src/server.ts" 2>/dev/null || true
  [ -f "$app_dir/watch.pid" ] && kill -9 "$(cat "$app_dir/watch.pid")" 2>/dev/null || true
  rm -f "$pidfile" "$app_dir/watch.pid" .rebuild.lock
  color 2; echo "[run] ✅ Stopped."; norm
}

status(){
  if kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then color 2; echo "[run] server: UP"; norm; else color 1; echo "[run] server: DOWN"; norm; fi
  if [ -f "$app_dir/watch.pid" ] && kill -0 "$(cat "$app_dir/watch.pid" 2>/dev/null)" 2>/dev/null; then color 2; echo "[run] watcher: UP"; norm; else color 1; echo "[run] watcher: DOWN"; norm; fi
}

logs(){ tail -n 120 -f "$logfile"; }

case "${1:-start}" in
  start) start ;;
  stop)  stop  ;;
  status) status ;;
  logs) logs ;;
  *) echo "Usage: ./run.sh {start|stop|status|logs}"; exit 2 ;;
esac
